# Copie para `.env` e preencha. O `.env` está no .gitignore — nunca o versione.

# --- Telegram (obrigatório) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Fontes de Threat Intel (opcionais, aumentam rate limit / habilitam fontes) ---
NVD_API_KEY=
GITHUB_TOKEN=
ABUSECH_AUTH_KEY=

# --- Execução ---
POLL_INTERVAL_MINUTES=30
LOG_LEVEL=INFO
DB_PATH=data/atalaia.db
WATCHLIST_PATH=config/watchlist.yaml

# --- Janela e volume ---
# 1ª execução: quantos dias para trás buscar
INITIAL_LOOKBACK_DAYS=3
# Ignora CVEs publicadas há mais tempo (exceto entradas novas no KEV)
CVE_MAX_AGE_DAYS=30
# Acima disso, o restante da rodada vai num resumo único
MAX_ALERTS_PER_RUN=15
HTTP_TIMEOUT_SECONDS=30
